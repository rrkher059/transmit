# 7RANSMI7 — Test environment (copy to .env.test, fill in, do not commit).
#
# Point this at a SEPARATE Supabase project from dev/prod. server/testDbSetup.ts
# truncates every table in this database before each test file runs, so
# pointing it at a real project would destroy real data.
DATABASE_URL=postgres://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Apply the schema to this database once (and again after any schema.sql
# change) with: npm run db:schema:test

# Safety guard (server/testDbSetup.ts): the PRODUCTION Supabase project's ref
# — everything above must never be able to match this. Not a secret, just an
# identifier (the same string that appears in prod's own connection string,
# as db.<ref>.supabase.co or the postgres.<ref> pooler username). Left unset,
# the test suite refuses to run at all rather than skip the check.
PRODUCTION_PROJECT_REF=your-production-project-ref

# Optional here — server/db.ts falls back to a documented dev/test-only
# default when unset (matches SESSION_SECRET's pattern). Set this to your
# test project's real JWT Secret (Supabase dashboard > Settings > API) only
# if you need tokens that a real Supabase service would also accept.
# SUPABASE_JWT_SECRET=
